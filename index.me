  <script src="/_sdk/6e31def43ecdfeab.editing_sdk.js" integrity="sha512-dLsCmEXoPwwgpykZ4cBcMyQIrP+91IJR9KNOwXo5DW+WeKKF+Uo/SerDyq8ysa/BlG5uxbgAtmcz7kiob0VKYA=="></script>
  <script>
    let currentQuestion = 0;
    let score = 0;
    const scoredQuestions = new Set();
    const motion = new Map();
    let dragCard = null;
    let pointerOffset = { x: 0, y: 0 };

    const panels = Array.from(document.querySelectorAll('.question-panel'));
    const feedback = document.getElementById('feedback');

    function activePanel() {
      return panels[currentQuestion];
    }

    function updateScore() {
      document.getElementById('score-value').textContent = score + ' / 10';
    }

    function updateQuestionNumber() {
      document.getElementById('question-number').textContent = 'QUESTION ' + (currentQuestion + 1) + ' OF 10';
    }

    function randomizeCard(card, bank) {
      const maxX = Math.max(8, bank.clientWidth - card.offsetWidth - 8);
      const maxY = Math.max(8, bank.clientHeight - card.offsetHeight - 8);
      const velocity = 0.45 + Math.random() * 0.8;
      const angle = Math.random() * Math.PI * 2;
      card.style.left = (8 + Math.random() * Math.max(1, maxX - 8)) + 'px';
      card.style.top = (8 + Math.random() * Math.max(1, maxY - 8)) + 'px';
      motion.set(card, { x: parseFloat(card.style.left), y: parseFloat(card.style.top), vx: Math.cos(angle) * velocity, vy: Math.sin(angle) * velocity });
    }

    function preparePanel(panel) {
      const bank = panel.querySelector('.word-bank');
      panel.querySelectorAll('.word-card').forEach(card => {
        card.classList.remove('placed');
        bank.appendChild(card);
        randomizeCard(card, bank);
      });
      panel.querySelector('.answer-zone').classList.remove('correct', 'incorrect');
    }

    function animateWords() {
      panels.forEach(panel => {
        if (!panel.classList.contains('active')) return;
        const bank = panel.querySelector('.word-bank');
        panel.querySelectorAll('.word-card:not(.placed):not(.dragging)').forEach(card => {
          const state = motion.get(card);
          if (!state) return;
          const maxX = bank.clientWidth - card.offsetWidth;
          const maxY = bank.clientHeight - card.offsetHeight;
          state.x += state.vx;
          state.y += state.vy;
          if (state.x <= 0 || state.x >= maxX) {
            state.vx *= -1;
            state.x = Math.max(0, Math.min(maxX, state.x));
          }
          if (state.y <= 0 || state.y >= maxY) {
            state.vy *= -1;
            state.y = Math.max(0, Math.min(maxY, state.y));
          }
          card.style.left = state.x + 'px';
          card.style.top = state.y + 'px';
        });
      });
      requestAnimationFrame(animateWords);
    }

    function placeCard(card, zone) {
      card.classList.remove('dragging');
      card.classList.add('placed');
      zone.appendChild(card);
      zone.classList.remove('correct', 'incorrect');
      feedback.textContent = '';
    }

    function returnCard(card) {
      const panel = activePanel();
      const bank = panel.querySelector('.word-bank');
      card.classList.remove('placed', 'dragging');
      bank.appendChild(card);
      randomizeCard(card, bank);
      panel.querySelector('.answer-zone').classList.remove('correct', 'incorrect');
      feedback.textContent = '';
    }

    function cardPointerDown(event) {
      const card = event.currentTarget;
      if (card.classList.contains('placed')) {
        returnCard(card);
        return;
      }
      dragCard = card;
      const rect = card.getBoundingClientRect();
      pointerOffset = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      card.classList.add('dragging');
      card.setPointerCapture(event.pointerId);
    }

    function cardPointerMove(event) {
      if (!dragCard || event.currentTarget !== dragCard) return;
      const bank = activePanel().querySelector('.word-bank');
      const bankRect = bank.getBoundingClientRect();
      const state = motion.get(dragCard);
      if (!state) return;
      state.x = Math.max(0, Math.min(bank.clientWidth - dragCard.offsetWidth, event.clientX - bankRect.left - pointerOffset.x));
      state.y = Math.max(0, Math.min(bank.clientHeight - dragCard.offsetHeight, event.clientY - bankRect.top - pointerOffset.y));
      dragCard.style.left = state.x + 'px';
      dragCard.style.top = state.y + 'px';
    }

    function cardPointerUp(event) {
      if (!dragCard || event.currentTarget !== dragCard) return;
      const zone = activePanel().querySelector('.answer-zone');
      const zoneRect = zone.getBoundingClientRect();
      const inside = event.clientX >= zoneRect.left && event.clientX <= zoneRect.right && event.clientY >= zoneRect.top && event.clientY <= zoneRect.bottom;
      if (inside) placeCard(dragCard, zone);
      else dragCard.classList.remove('dragging');
      dragCard = null;
    }

    function checkAnswer() {
      const panel = activePanel();
      const chosen = Array.from(panel.querySelectorAll('.answer-zone .word-card')).map(card => card.dataset.word).join('|');
      const correct = panel.dataset.answer;
      const zone = panel.querySelector('.answer-zone');

      zone.classList.remove('correct', 'incorrect');
      if (chosen === correct) {
        zone.classList.add('correct');
        if (!scoredQuestions.has(currentQuestion)) {
          scoredQuestions.add(currentQuestion);
          score++;
          updateScore();
        }
        feedback.textContent = 'Hebat! Kalimatmu benar! 🎉';
        feedback.className = 'feedback mt-5 text-center text-base font-bold text-emerald-600';
      } else {
        zone.classList.add('incorrect');
        feedback.textContent = 'Belum tepat. Coba susun lagi, ya! 💪';
        feedback.className = 'feedback mt-5 text-center text-base font-bold text-rose-500';
      }
    }

    function resetQuestion() {
      preparePanel(activePanel());
      feedback.textContent = '';
      feedback.className = 'feedback mt-5 text-center text-base font-bold';
    }

    function nextQuestion() {
      panels[currentQuestion].classList.remove('active');
      currentQuestion = (currentQuestion + 1) % panels.length;
      panels[currentQuestion].classList.add('active');
      preparePanel(activePanel());
      updateQuestionNumber();
      feedback.textContent = '';
      feedback.className = 'feedback mt-5 text-center text-base font-bold';
    }

    document.querySelectorAll('.word-card').forEach(card => {
      card.addEventListener('pointerdown', cardPointerDown);
      card.addEventListener('pointermove', cardPointerMove);
      card.addEventListener('pointerup', cardPointerUp);
      card.addEventListener('pointercancel', cardPointerUp);
    });

    document.getElementById('check-button').addEventListener('click', checkAnswer);
    document.getElementById('reset-button').addEventListener('click', resetQuestion);
    document.getElementById('next-button').addEventListener('click', nextQuestion);

    window.addEventListener('resize', () => {
      const panel = activePanel();
      panel.querySelectorAll('.word-card:not(.placed)').forEach(card => randomizeCard(card, panel.querySelector('.word-bank')));
    });

    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      preparePanel(activePanel());
      updateScore();
      updateQuestionNumber();
      requestAnimationFrame(animateWords);
    });
  </script>
 </body>
</html>
